                      {{/each}}
                    </select>
                  </div>
                </div>
                {{/each}}
              </div>
            </div>

          </div>{{!-- /vn-char-inspector-body --}}
          {{/each}}

        </div>{{!-- /vn-char-inspector --}}

      </div>{{!-- /vn-chars-split --}}
    </div>{{!-- /chars --}}


