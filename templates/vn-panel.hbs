                  <button type="button" class="dd-icon-btn dd-btn-danger-sm" data-char-action="remove-emotion" data-emo-idx="{{@index}}" title="{{localize "DRAMADIRECTOR.vn.emotionRemove"}}"><i class="fas fa-times"></i></button>
