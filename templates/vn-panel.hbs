          <input type="text" id="vn-layers-preset-name" placeholder="{{localize "DRAMADIRECTOR.presetName"}}" class="dd-input" style="flex:1"/>
          <button type="button" data-action="vn-layers-save"  title="{{localize "DRAMADIRECTOR.presetSave"}}"><i class="fas fa-save"></i></button>
          <button type="button" data-action="vn-layers-macro" class="vn-btn-secondary" title="{{localize "DRAMADIRECTOR.generateMacro"}}"><i class="fas fa-code"></i></button>
        </div>
        <div id="vn-layers-macro-wrap" class="vn-macro-wrap" style="display:none;margin-top:6px;position:relative">
          <pre class="vn-macro-example"></pre>
          <button type="button" class="vn-macro-copy-btn" title="Copy"><i class="fas fa-copy"></i></button>
        </div>
      </section>
    </div>{{!-- /layers --}}


