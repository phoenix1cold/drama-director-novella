    {{!-- ─── LAYERS (Text & Pics) ─── --}}
    <div class="vn-tab-content dd-hidden" data-vtab-content="layers">
      <section class="dd-section">
        <div class="vn-tp-section-header">
          <h3><i class="fas fa-layer-group"></i> {{localize "DRAMADIRECTOR.vn.tabLayers"}}</h3>
          <div style="display:flex;gap:5px">
            <button type="button" data-action="vn-layer-add-img"  class="vn-btn-add"><i class="fas fa-image"></i> + {{localize "DRAMADIRECTOR.imageLayer"}}</button>
            <button type="button" data-action="vn-layer-add-text" class="vn-btn-add"><i class="fas fa-font"></i> + {{localize "DRAMADIRECTOR.textLayer"}}</button>
            <button type="button" data-action="vn-layers-clear"   class="vn-btn-danger" title="{{localize "DRAMADIRECTOR.clearAll"}}"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <p class="dd-hint" style="font-size:11px;color:#888;margin:0 0 6px">{{{localize "DRAMADIRECTOR.vn.layersHint"}}}</p>
        <div class="vn-layer-list" id="vn-layer-list">
          {{#each layers}}
          <div class="vn-layer-row {{#if (ddEq this.type 'text')}}vn-layer-row-text{{else}}vn-layer-row-img{{/if}}" data-layer-idx="{{this._idx}}">
            <div class="vn-layer-row-header">
              <span class="vn-layer-type-badge {{this.type}}">{{this.type}}</span>
              <input type="text" class="vn-layer-name-inp dd-input" value="{{this.name}}" placeholder="{{localize "DRAMADIRECTOR.layerName"}}" style="flex:1;max-width:120px"/>
              <label style="display:flex;align-items:center;gap:3px;font-size:11px;color:#888"><input type="checkbox" class="vn-layer-visible" {{#if this.visible}}checked{{/if}}/> {{localize "DRAMADIRECTOR.layerVisible"}}</label>
              <label style="display:flex;align-items:center;gap:3px;font-size:11px;color:#888"><input type="checkbox" class="vn-layer-locked"  {{#if this.locked}} checked{{/if}}/> <i class="fas fa-lock" style="color:#f66"></i></label>
              <button type="button" data-layer-action="move-up"   class="vn-order-btn" title="{{localize "DRAMADIRECTOR.layerMoveUp"}}"><i class="fas fa-arrow-up"></i></button>
              <button type="button" data-layer-action="move-down" class="vn-order-btn" title="{{localize "DRAMADIRECTOR.layerMoveDown"}}"><i class="fas fa-arrow-down"></i></button>
              <button type="button" data-layer-action="remove"    class="dd-btn-danger" title="{{localize "DRAMADIRECTOR.layerRemove"}}"><i class="fas fa-times"></i></button>
            </div>
            <div class="vn-tag-input-wrap vn-layer-tags-wrap" style="margin:3px 0 2px">
