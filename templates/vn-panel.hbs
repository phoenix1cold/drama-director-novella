<div class="vn-panel-layout">

  {{!-- ═══ SIDEBAR ═══ --}}
  <div class="vn-sidebar">

    <div class="vn-sidebar-status">
      {{#if open}}
        <span class="vn-sidebar-status-dot vn-status-on"></span>
        <span class="vn-sidebar-status-text">{{localize "DRAMADIRECTOR.vn.statusActive"}}</span>
        <button type="button" data-action="vn-close" class="vn-sidebar-stop" title="{{localize "DRAMADIRECTOR.vn.close"}}"><i class="fas fa-stop"></i></button>
      {{else}}
        <span class="vn-sidebar-status-dot vn-status-off"></span>
        <span class="vn-sidebar-status-text">{{localize "DRAMADIRECTOR.vn.statusInactive"}}</span>
      {{/if}}
    </div>

    {{#unless open}}
    <div class="vn-sidebar-launch">
      <button type="button" data-action="vn-open" class="vn-btn-primary vn-sidebar-launch-btn" style="background:#16a34a;color:#fff;border:none;box-shadow:0 2px 10px rgba(22,163,74,.4)">
        <i class="fas fa-play"></i> {{localize "DRAMADIRECTOR.vn.launch"}}
      </button>
      <button type="button" data-action="vn-open-local" class="vn-btn-secondary vn-sidebar-launch-btn" title="{{localize "DRAMADIRECTOR.vn.launchLocalTitle"}}" style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.18);color:#aaa">
        <i class="fas fa-eye"></i> {{localize "DRAMADIRECTOR.vn.launchLocal"}}
      </button>
    </div>
    {{/unless}}

    <button type="button" data-action="vn-open-map" class="vn-btn-secondary vn-launch-map" title="Импортировать персонажей игроков с текущей карты в новеллу">
      <i class="fas fa-users"></i> Launch with characters on map
    </button>
    <nav class="vn-sidebar-nav">
      <button class="vn-nav-btn" data-vtab="3d">
        <i class="fas fa-cube"></i><span>3D</span>
      </button>
      <button class="vn-nav-btn" data-vtab="scene">
        <i class="fas fa-image"></i><span>{{localize "DRAMADIRECTOR.vn.tabBackground"}}</span>
      </button>
      <button class="vn-nav-btn" data-vtab="chars">
        <i class="fas fa-users"></i><span>{{localize "DRAMADIRECTOR.vn.tabCharacters"}}</span>
      </button>
      <button class="vn-nav-btn" data-vtab="dialogue">
        <i class="fas fa-comment-dots"></i><span>{{localize "DRAMADIRECTOR.vn.tabDialogue"}}</span>
      </button>
      <button class="vn-nav-btn" data-vtab="layers">
        <i class="fas fa-layer-group"></i><span>{{localize "DRAMADIRECTOR.vn.tabLayers"}}</span>
      </button>
      <button class="vn-nav-btn" data-vtab="interactive">
        <i class="fas fa-hand-pointer"></i><span>{{localize "DRAMADIRECTOR.vn.tabInteractive"}}</span>
      </button>
      <button class="vn-nav-btn" data-vtab="presets">
        <i class="fas fa-bookmark"></i><span>{{localize "DRAMADIRECTOR.vn.tabPresets"}}</span>
      </button>
      <div class="vn-sidebar-sep"></div>
      <button class="vn-nav-btn" data-vtab="settings">
        <i class="fas fa-sliders-h"></i><span>{{localize "DRAMADIRECTOR.vn.tabSettings"}}</span>
      </button>
      <button class="vn-nav-btn" data-vtab="help">
        <i class="fas fa-question-circle"></i><span>{{localize "DRAMADIRECTOR.vn.tabHelp"}}</span>
      </button>
    </nav>

  </div>{{!-- /vn-sidebar --}}

  {{!-- ═══ PANEL BODY ═══ --}}
  <div class="vn-panel-body">
    <div class="vn-tab-content dd-hidden" data-vtab-content="3d">
      <h3><i class="fas fa-cube"></i> 3D</h3>
      <div id="vn-3d-editor"></div>
    </div>

    {{!-- ─── SCENE / BACKGROUND ─── --}}
    <div class="vn-tab-content dd-hidden" data-vtab-content="scene">

      <section class="dd-section">
        <h3><i class="fas fa-image"></i> {{localize "DRAMADIRECTOR.vn.bgSection"}}</h3>
        <div class="dd-row">
          <input type="text" id="vn-bg-path" value="{{background}}" placeholder="{{localize "DRAMADIRECTOR.vn.bgPath"}}" class="dd-input"/>
          <button type="button" data-action="vn-browse-bg"><i class="fas fa-folder-open"></i></button>
        </div>
        <div class="dd-row" style="margin-top:6px;gap:10px;flex-wrap:wrap">
          <label class="dd-row-pair"><span>{{localize "DRAMADIRECTOR.vn.bgFit"}}</span>
            <select id="vn-bg-fit" class="dd-select-sm">
              <option value="cover"   {{#if (ddEq bgFit "cover")}}selected{{/if}}>cover</option>
              <option value="contain" {{#if (ddEq bgFit "contain")}}selected{{/if}}>contain</option>
              <option value="fill"    {{#if (ddEq bgFit "fill")}}selected{{/if}}>fill</option>
            </select>
          </label>
          <label class="dd-row-pair"><span>{{localize "DRAMADIRECTOR.vn.bgColor"}}</span>
            <input type="color" id="vn-bg-color" value="{{bgColor}}" class="dd-color"/>
          </label>
          <label class="dd-row-pair" style="flex:1"><span>{{localize "DRAMADIRECTOR.vn.bgDim"}} <span id="vn-dim-val">{{dimBg}}</span></span>
            <input type="range" id="vn-dim" value="{{dimBg}}" min="0" max="1" step="0.05" style="flex:1;min-width:80px"/>
          </label>
        </div>
      </section>

      <section class="dd-section">
        <div class="vn-bg-section-header">
          <h3 style="margin:0"><i class="fas fa-th"></i> {{localize "DRAMADIRECTOR.vn.bgQuickSelect"}}</h3>
          <div style="display:flex;gap:4px">
            <button type="button" data-action="vn-bg-add-folder" class="vn-btn-add" title="{{localize "DRAMADIRECTOR.vn.bgAddFolder"}}"><i class="fas fa-folder-open"></i> {{localize "DRAMADIRECTOR.vn.bgAddFolder"}}</button>
            <button type="button" data-action="vn-bg-add" class="vn-btn-add"><i class="fas fa-plus"></i> {{localize "DRAMADIRECTOR.vn.bgAdd"}}</button>
          </div>
        </div>
        <div class="vn-chars-search" style="margin:6px 0">
          <input type="text" id="vn-bg-search" class="dd-input" placeholder="{{localize "DRAMADIRECTOR.vn.bgSearch"}}"/>
        </div>
        {{#each allBg}}
        <details class="vn-bg-panel-group" data-bg-id="{{this.id}}" data-bg-group-name="{{this.name}}" open>
          <summary class="vn-bg-panel-group-header">
            <i class="fas fa-chevron-right vn-bg-panel-chev"></i>
            <span class="vn-bg-group-name">{{this.name}}</span>
            <span class="vn-bg-group-count">{{this.variants.length}}</span>
            {{#unless this._builtin}}
            <div class="vn-bg-group-actions">
              <button type="button" data-bg-move="{{this.id}}:left"  class="vn-bg-move-btn" title="{{localize "DRAMADIRECTOR.vn.bgMoveLeft"}}"><i class="fas fa-arrow-left"></i></button>
              <button type="button" data-bg-move="{{this.id}}:right" class="vn-bg-move-btn" title="{{localize "DRAMADIRECTOR.vn.bgMoveRight"}}"><i class="fas fa-arrow-right"></i></button>
              <button type="button" data-bg-edit="{{this.id}}"   class="vn-bg-move-btn" title="{{localize "DRAMADIRECTOR.vn.bgEdit.button"}}"><i class="fas fa-pencil-alt"></i></button>
              <button type="button" data-bg-delete="{{this.id}}" class="vn-bg-move-btn vn-bg-delete-btn" title="{{localize "DRAMADIRECTOR.vn.bgDelete"}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/unless}}
          </summary>
          <div class="vn-bg-tiles">
            {{#each this.variants}}
            <button type="button" class="vn-bg-tile" data-bg-variant="{{this.src}}" data-bg-variant-name="{{this.name}}" title="{{this.name}}">
              {{#if (ddIsVideo this.src)}}
                <div class="vn-bg-tile-video-wrap">
                  <video class="vn-bg-tile-video" src="{{this.src}}" muted loop preload="none"></video>
                  <i class="fas fa-film vn-bg-tile-video-icon"></i>
                </div>
              {{else}}
                <div class="vn-bg-tile-thumb" style="background-image:url('{{this.src}}')"></div>
              {{/if}}
              <span class="vn-bg-tile-name">{{this.name}}</span>
            </button>
            {{/each}}
          </div>
        </details>
        {{/each}}
      </section>

    </div>{{!-- /scene --}}


    {{!-- ─── CHARACTERS ─── --}}
    <div class="vn-tab-content vn-chars-tab dd-hidden" data-vtab-content="chars">
      <div class="vn-chars-split">

        {{!-- Left: compact card list --}}
        <div class="vn-chars-list-panel">

          {{!-- Toolbar (infinite-roster only — single Add button) --}}
          <div class="vn-chars-toolbar">
            <button type="button" data-action="vn-char-add-any" class="vn-btn-add" style="flex:1"><i class="fas fa-plus"></i> {{localize "DRAMADIRECTOR.vn.charAddAny"}}</button>
            <button type="button" data-action="vn-deactivate-all" class="vn-toolbar-icon-btn" title="{{localize "DRAMADIRECTOR.vn.charsDeactivateAll"}}"><i class="fas fa-eye-slash"></i></button>
          </div>

          {{!-- Search --}}
          <div style="padding:0 8px 6px">
            <input type="text" id="vn-char-search" class="dd-input" placeholder="{{localize "DRAMADIRECTOR.vn.charsSearch"}}"/>
          </div>

          {{!-- Compact cards --}}
          <div class="vn-char-cards" id="vn-char-cards">
            {{#each chars}}
            <div class="vn-char-card {{#if this.active}}vn-char-card-active{{/if}}"
                 data-char-id="{{this.id}}" data-char-idx="{{this._idx}}"
                 data-char-name="{{this.name}}">
              <div class="vn-char-card-thumb">
                {{#if this.img}}<img src="{{this.img}}" alt=""/>
                {{else}}<div class="vn-char-card-thumb-empty"><i class="fas fa-user-circle"></i></div>{{/if}}
              </div>
              <div class="vn-char-card-info">
                <span class="vn-char-card-name">{{#if this.name}}{{this.name}}{{else}}—{{/if}}</span>
                <span class="vn-char-card-meta">
                  <span class="vn-char-side-dot {{this.side}}">{{#if (ddEq this.side "left")}}◀{{else if (ddEq this.side "center")}}◆{{else}}▶{{/if}}</span>
                  {{#if this.activeEmotion}}<span class="vn-char-emo-dot" title="{{this.activeEmotion}}"><i class="fas fa-theater-masks"></i></span>{{/if}}
                </span>
              </div>
              <div class="vn-char-card-btns">
                <button type="button" class="vn-card-btn vn-card-activate {{#if this.active}}vn-card-btn-on{{/if}}" data-char-action="active" title="{{localize "DRAMADIRECTOR.vn.charActivate"}}"><i class="fas fa-lightbulb"></i></button>
                <button type="button" class="vn-card-btn vn-card-remove" data-char-action="remove" title="{{localize "DRAMADIRECTOR.vn.charRemove"}}"><i class="fas fa-times"></i></button>
              </div>
            </div>
            {{else}}
            <div class="vn-chars-empty-state"><i class="fas fa-user-plus"></i><span>{{localize "DRAMADIRECTOR.vn.charEmpty"}}</span></div>
            {{/each}}
          </div>

          {{!-- Roster presets --}}
          <div class="vn-chars-preset-footer">
            <div class="vn-chars-preset-load-row">
            <select id="vn-chars-preset-select" class="dd-select">
              <option value="">{{localize "DRAMADIRECTOR.vn.rosterLoad"}}</option>
              {{#each charPresets}}<option value="{{this}}">{{this}}</option>{{/each}}
            </select>
            <button type="button" data-action="vn-chars-load" title="{{localize "DRAMADIRECTOR.presetLoad"}}"><i class="fas fa-upload"></i></button>
            <button type="button" data-action="vn-chars-delete" class="dd-btn-danger" title="{{localize "DRAMADIRECTOR.presetDelete"}}"><i class="fas fa-trash"></i></button>
            </div>
            <div class="vn-chars-preset-save-row">
            <input type="text" id="vn-chars-preset-name" placeholder="{{localize "DRAMADIRECTOR.vn.rosterName"}}" class="dd-input"/>
            <button type="button" data-action="vn-chars-save" title="{{localize "DRAMADIRECTOR.presetSave"}}"><i class="fas fa-save"></i></button>
            </div>
          </div>

        </div>{{!-- /vn-chars-list-panel --}}

        {{!-- Right: inspector --}}
        <div class="vn-char-inspector" id="vn-char-inspector">

          <div class="vn-char-inspector-empty" id="vn-char-inspector-empty">
            <i class="fas fa-hand-pointer"></i>
            <span>{{localize "DRAMADIRECTOR.vn.charInspectorHint"}}</span>
          </div>

          {{#each chars}}
          <div class="vn-char-inspector-body dd-hidden"
               data-inspector-for="{{this.id}}"
               data-char-idx="{{this._idx}}">

            {{!-- Inspector header --}}
            <div class="vn-insp-header">
              <input type="text" class="vn-char-name-inp vn-insp-name" value="{{this.name}}" placeholder="{{localize "DRAMADIRECTOR.vn.charName"}}"/>
              <input type="color" class="vn-char-ncolor vn-insp-namecolor" value="{{this.nameColor}}"/>
              <input type="text" class="vn-char-title-inp vn-insp-title" value="{{this.title}}" placeholder="{{localize "DRAMADIRECTOR.vn.charTitle"}}"/>
              <div class="vn-insp-header-actions">
                <button type="button" class="vn-insp-action-btn" data-char-action="switch-side" title="{{localize "DRAMADIRECTOR.vn.charSwitchSide"}}"><i class="fas fa-exchange-alt"></i></button>
                <button type="button" class="vn-insp-action-btn" data-char-action="move-up"    title="{{localize "DRAMADIRECTOR.vn.charMoveUp"}}"><i class="fas fa-arrow-up"></i></button>
                <button type="button" class="vn-insp-action-btn" data-char-action="move-down"  title="{{localize "DRAMADIRECTOR.vn.charMoveDown"}}"><i class="fas fa-arrow-down"></i></button>
              </div>
            </div>

            {{!-- Two columns --}}
            <div class="vn-character-bindings">
              <label>Foundry Actor
                <select class="vn-char-actor dd-select">
                  <option value="">— Не привязан —</option>
                  {{#each ../actors}}<option value="{{this.id}}" {{#if (ddEq this.id ../actorId)}}selected{{/if}}>{{this.name}}</option>{{/each}}
                </select>
              </label>
              <label>Токен текущей карты (необязательно)
                <select class="vn-char-token dd-select">
                  <option value="">— По Actor —</option>
                  {{#each ../mapTokens}}<option value="{{this.id}}" {{#if (ddEq this.id ../tokenUuid)}}selected{{/if}}>{{this.name}}</option>{{/each}}
                </select>
              </label>
              <label>Spawnpoint
                <select class="vn-char-spawnpoint dd-select">
                  <option value="">— Автоматически —</option>
                  {{#each ../spawnpoints}}<option value="{{this.id}}" {{#if (ddEq this.id ../spawnpointId)}}selected{{/if}}>{{this.name}}</option>{{/each}}
                </select>
              </label>
            </div>
            <div class="vn-insp-cols">

              {{!-- Col 1: Portrait images --}}
              <div class="vn-insp-col">
                <div class="vn-insp-field">
                  <label class="vn-insp-lbl">{{localize "DRAMADIRECTOR.vn.charImage"}}</label>
                  <div class="vn-insp-file-row">
                    <input type="text" class="vn-char-img-inp dd-input" value="{{this.img}}" placeholder="…"/>
                    <button type="button" data-char-action="browse"><i class="fas fa-folder-open"></i></button>
                  </div>
                </div>
                <div class="vn-insp-field">
                  <label class="vn-insp-lbl">{{localize "DRAMADIRECTOR.vn.charActiveImage"}}</label>
                  <div class="vn-insp-file-row">
                    <input type="text" class="vn-char-active-img-inp dd-input" value="{{this.activeImg}}" placeholder="…"/>
                    <button type="button" data-char-action="browse-active"><i class="fas fa-folder-open"></i></button>
                  </div>
                </div>
                {{#if this.img}}
                <div class="vn-insp-portrait-preview">
                  <img src="{{this.img}}" alt="{{this.name}}"/>
                  {{#if this.activeImg}}<img src="{{this.activeImg}}" alt="active" class="vn-insp-preview-active"/>{{/if}}
                </div>
                {{/if}}
              </div>

              {{!-- Col 2: Transform + flags --}}
              <div class="vn-insp-col">

                {{!-- Spinners --}}
                <div class="vn-insp-field">
                  <label class="vn-insp-lbl">{{localize "DRAMADIRECTOR.vn.charScale"}}{{#if ../depthMode}} <i class="fas fa-layer-group" style="color:#ffe066;font-size:9px" title="{{localize "DRAMADIRECTOR.vn.depthModeTitle"}}"></i>{{/if}}</label>
                  <input type="number" class="vn-char-scale vn-spinner" value="{{#if this.baseScale}}{{this.baseScale}}{{else}}{{#if this.scale}}{{this.scale}}{{else}}1{{/if}}{{/if}}" min="0.05" max="15" step="0.05"/>
                </div>
                <div class="vn-insp-spinners-grid">
                  <div class="vn-insp-spinner-cell">
                    <label>X</label>
                    <input type="number" class="vn-char-x vn-spinner" value="{{this.x}}" step="5"/>
                  </div>
                  <div class="vn-insp-spinner-cell">
                    <label>Y</label>
                    <input type="number" class="vn-char-y vn-spinner" value="{{this.y}}" step="5"/>
                  </div>
                  <div class="vn-insp-spinner-cell">
                    <label>Z</label>
                    <input type="number" class="vn-char-z vn-spinner" value="{{this.zIndex}}" step="1"/>
                  </div>
                </div>

                {{!-- Flags --}}
                <div class="vn-insp-flags">
                  <label class="vn-insp-flag"><input type="checkbox" class="vn-char-mirror"  {{#if this.mirror}} checked{{/if}}/> {{localize "DRAMADIRECTOR.vn.charMirror"}}</label>
                  <label class="vn-insp-flag"><input type="checkbox" class="vn-char-visible" {{#if this.visible}}checked{{/if}}/> {{localize "DRAMADIRECTOR.vn.charVisible"}}</label>
                  <label class="vn-insp-flag"><input type="checkbox" class="vn-char-locked"  {{#if this.locked}} checked{{/if}}/> <i class="fas fa-lock" style="color:#f87171;font-size:9px"></i> {{localize "DRAMADIRECTOR.vn.charLocked"}}</label>
                </div>

                {{!-- Animations --}}
                <div class="vn-insp-field" style="margin-top:6px">
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px">
                    <label style="font-size:10px;color:#888">{{localize "DRAMADIRECTOR.vn.animLabel"}}</label>
                    <label style="font-size:10px;color:#888">{{localize "DRAMADIRECTOR.vn.animHideLabel"}}</label>
                    <select class="vn-char-anim-in dd-select" style="font-size:10px">
                      <option value="none" {{#if (ddEq this.animIn "none")}}selected{{/if}}>— Нет —</option>
                      <option value="fade" {{#if (ddEq this.animIn "fade")}}selected{{/if}}>Угасание</option>
                      <option value="zoomIn" {{#if (ddEq this.animIn "zoomIn")}}selected{{/if}}>Увеличение</option>
                      <option value="zoomOut" {{#if (ddEq this.animIn "zoomOut")}}selected{{/if}}>Уменьшение</option>
                      <option value="slideUp" {{#if (ddEq this.animIn "slideUp")}}selected{{/if}}>Слайд снизу</option>
                      <option value="slideDown" {{#if (ddEq this.animIn "slideDown")}}selected{{/if}}>Слайд сверху</option>
                      <option value="slideLeft" {{#if (ddEq this.animIn "slideLeft")}}selected{{/if}}>Слайд справа</option>
                      <option value="slideRight" {{#if (ddEq this.animIn "slideRight")}}selected{{/if}}>Слайд слева</option>
                      <option value="blur" {{#if (ddEq this.animIn "blur")}}selected{{/if}}>Размытие</option>
                      <option value="rise" {{#if (ddEq this.animIn "rise")}}selected{{/if}}>Подъём</option>
                      <option value="drop" {{#if (ddEq this.animIn "drop")}}selected{{/if}}>Падение</option>
                      <option value="spin" {{#if (ddEq this.animIn "spin")}}selected{{/if}}>Вращение</option>
                      <option value="flip" {{#if (ddEq this.animIn "flip")}}selected{{/if}}>Переворот X</option>
                      <option value="flipY" {{#if (ddEq this.animIn "flipY")}}selected{{/if}}>Переворот Y</option>
                      <option value="swipeLeft" {{#if (ddEq this.animIn "swipeLeft")}}selected{{/if}}>Сдвиг влево</option>
                      <option value="swipeRight" {{#if (ddEq this.animIn "swipeRight")}}selected{{/if}}>Сдвиг вправо</option>
                    </select>
                    <select class="vn-char-anim-out dd-select" style="font-size:10px">
                      <option value="none" {{#if (ddEq this.animOut "none")}}selected{{/if}}>— Нет —</option>
                      <option value="fade" {{#if (ddEq this.animOut "fade")}}selected{{/if}}>Угасание</option>
                      <option value="zoomIn" {{#if (ddEq this.animOut "zoomIn")}}selected{{/if}}>Увеличение</option>
                      <option value="zoomOut" {{#if (ddEq this.animOut "zoomOut")}}selected{{/if}}>Уменьшение</option>
                      <option value="slideUp" {{#if (ddEq this.animOut "slideUp")}}selected{{/if}}>Слайд снизу</option>
                      <option value="slideDown" {{#if (ddEq this.animOut "slideDown")}}selected{{/if}}>Слайд сверху</option>
                      <option value="slideLeft" {{#if (ddEq this.animOut "slideLeft")}}selected{{/if}}>Слайд справа</option>
                      <option value="slideRight" {{#if (ddEq this.animOut "slideRight")}}selected{{/if}}>Слайд слева</option>
                      <option value="blur" {{#if (ddEq this.animOut "blur")}}selected{{/if}}>Размытие</option>
                      <option value="rise" {{#if (ddEq this.animOut "rise")}}selected{{/if}}>Подъём</option>
                      <option value="drop" {{#if (ddEq this.animOut "drop")}}selected{{/if}}>Падение</option>
                      <option value="spin" {{#if (ddEq this.animOut "spin")}}selected{{/if}}>Вращение</option>
                      <option value="flip" {{#if (ddEq this.animOut "flip")}}selected{{/if}}>Переворот X</option>
                      <option value="flipY" {{#if (ddEq this.animOut "flipY")}}selected{{/if}}>Переворот Y</option>
                      <option value="swipeLeft" {{#if (ddEq this.animOut "swipeLeft")}}selected{{/if}}>Сдвиг влево</option>
                      <option value="swipeRight" {{#if (ddEq this.animOut "swipeRight")}}selected{{/if}}>Сдвиг вправо</option>
                    </select>
                  </div>
                </div>

                {{!-- Player binding --}}
                <div class="vn-insp-field" style="margin-top:6px">
                  <label class="vn-insp-lbl">{{localize "DRAMADIRECTOR.vn.charPlayer"}}</label>
                  <select class="vn-char-player dd-select">
                    <option value="">{{localize "DRAMADIRECTOR.vn.charNoPlayer"}}</option>
                    {{#each ../players}}
                    <option value="{{this.id}}" {{#if (ddEq ../playerId this.id)}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                  </select>
                </div>

                {{!-- Tags --}}
                <div class="vn-insp-field" style="margin-top:6px">
                  <label class="vn-insp-lbl"><i class="fas fa-tag" style="color:var(--vn-amber)"></i> Теги</label>
                  <div class="vn-tag-input-wrap" data-char-tags>
                    <div class="vn-tag-chips-row">
                      {{#each this.tags}}<span class="vn-tag-chip">{{this}}<button class="vn-tag-chip-del" data-tag="{{this}}" tabindex="-1">×</button></span>{{/each}}
                    </div>
                    <input class="vn-tag-inp dd-input" type="text" placeholder='{{localize "DRAMADIRECTOR.vn.tagPlaceholder"}}' autocomplete="off"/>
